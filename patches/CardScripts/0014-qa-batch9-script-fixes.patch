diff --git a/official/c27178262.lua b/official/c27178262.lua
index da91a957..2c67c5ac 100644
--- a/official/c27178262.lua
+++ b/official/c27178262.lua
@@ -19,7 +19,10 @@ function s.costfilter(c,ft)
 end
 function s.cost(e,tp,eg,ep,ev,re,r,rp,chk)
 	local ft=Duel.GetLocationCount(tp,LOCATION_MZONE)
-	if chk==0 then return ft>-1 and Duel.IsExistingMatchingCard(s.costfilter,tp,LOCATION_MZONE,0,1,nil,ft) end
+	if chk==0 then
+		e:SetLabel(100) --FAQ 6817: the card sent as the cost can be the target
+		return ft>-1 and Duel.IsExistingMatchingCard(s.costfilter,tp,LOCATION_MZONE,0,1,nil,ft)
+	end
 	Duel.Hint(HINT_SELECTMSG,tp,HINTMSG_TOGRAVE)
