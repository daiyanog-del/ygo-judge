-function s.filter(c)
-	return c:IsFaceup() and c:IsSetCard(SET_DRAGUNITY) and c:IsRace(RACE_WINGEDBEAST)
+--FAQ 10056: it keeps targeting the monster once equipped, so it cannot be equipped to a monster this card cannot target
+function s.filter(c,e)
+	return c:IsFaceup() and c:IsSetCard(SET_DRAGUNITY) and c:IsRace(RACE_WINGEDBEAST) and c:IsCanBeEffectTarget(e)
