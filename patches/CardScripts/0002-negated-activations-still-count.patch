@@ -16,12 +16,23 @@ function s.initial_effect(c)
 	e1:SetOperation(s.effop)
 	c:RegisterEffect(e1)
 	--Keep track of the activations of a "Mulcharmy" monster's effect
-	Duel.AddCustomActivityCounter(id,ACTIVITY_CHAIN,function(re) return not (re:GetHandler():IsSetCard(SET_MULCHARMY) and re:IsMonsterEffect()) end)
+	--JudgemanAI 2026-11-23: count these activations with a flag instead of AddCustomActivityCounter, which the engine
+	--takes back when an activation is negated. Konami FAQ 7813: a negated activation still counts for this restriction.
+	aux.GlobalCheck(s,function()
+		local ge=Effect.CreateEffect(c)
+		ge:SetType(EFFECT_TYPE_FIELD+EFFECT_TYPE_CONTINUOUS)
+		ge:SetCode(EVENT_CHAINING)
+		ge:SetOperation(function(_,_,_,_,ev,re,_,rp)
+			local filter=function(re) return not (re:GetHandler():IsSetCard(SET_MULCHARMY) and re:IsMonsterEffect()) end
+			if not filter(re,rp,ev) then Duel.RegisterFlagEffect(rp,id+100,RESET_PHASE|PHASE_END,0,1) end
+		end)
+		Duel.RegisterEffect(ge,0)
+	end)
 end
 s.listed_series={SET_MULCHARMY}
 function s.effcost(e,tp,eg,ep,ev,re,r,rp,chk)
