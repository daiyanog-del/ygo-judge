diff --git a/utility.lua b/utility.lua
index 17abb8e5..bf60d277 100644
--- a/utility.lua
+++ b/utility.lua
@@ -3064,3 +3064,16 @@ Duel.LoadScript("proc_gemini.lua")
 Duel.LoadScript("proc_spirit.lua")
 Duel.LoadScript("proc_unofficial.lua")
 Duel.LoadScript("deprecated_functions.lua")
+
+--JudgemanAI [general:faq] FAQ 6059: "end this turn's Battle Phase" also ends a second Battle Phase this turn
+function Auxiliary.EndThisTurnBattlePhase(e)
+	local p=Duel.GetTurnPlayer()
+	Duel.SkipPhase(p,PHASE_BATTLE,RESET_PHASE|PHASE_BATTLE_STEP,1)
+	local e1=Effect.CreateEffect(e:GetHandler())
+	e1:SetType(EFFECT_TYPE_FIELD)
+	e1:SetCode(EFFECT_CANNOT_BP)
+	e1:SetProperty(EFFECT_FLAG_PLAYER_TARGET)
+	e1:SetTargetRange(1,0)
+	e1:SetReset(RESET_PHASE|PHASE_END)
+	Duel.RegisterEffect(e1,p)
+end
