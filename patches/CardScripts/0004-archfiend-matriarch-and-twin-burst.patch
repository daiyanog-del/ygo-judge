@@ -48,7 +48,10 @@ function s.rmcon(e,tp,eg,ep,ev,re,r,rp)
 	local c=e:GetHandler()
 	local bc=c:GetBattleTarget()
 	e:SetLabelObject(bc)
+	--JudgemanAI 2026-11-23: only while this card is still on the field, or after it was destroyed by battle. Konami FAQ
+	--23430: if an effect makes it leave the field before the end of the Damage Step, this effect cannot be activated.
 	return c==Duel.GetAttacker() and bc and c:IsStatus(STATUS_OPPO_BATTLE) and bc:IsOnField() and bc:IsRelateToBattle()
+		and (c:IsOnField() or c:IsReason(REASON_BATTLE))
 end
 function s.rmtg(e,tp,eg,ep,ev,re,r,rp,chk)
 	if chk==0 then return e:GetLabelObject():IsAbleToRemove() end
