diff --git a/official/c67045174.lua b/official/c67045174.lua
index 44e90c85..d58a09f7 100644
--- a/official/c67045174.lua
+++ b/official/c67045174.lua
@@ -17,6 +17,12 @@ function s.initial_effect(c)
 		ge1:SetCode(EVENT_BATTLED)
 		ge1:SetOperation(s.checkop)
 		Duel.RegisterEffect(ge1,0)
+		--FAQ 8757: a Gemini monster with its effects at damage calculation counts even if it loses them before it is destroyed
+		local ge2=Effect.CreateEffect(c)
+		ge2:SetType(EFFECT_TYPE_FIELD+EFFECT_TYPE_CONTINUOUS)
+		ge2:SetCode(EVENT_PRE_DAMAGE_CALCULATE)
+		ge2:SetOperation(s.precheck)
+		Duel.RegisterEffect(ge2,0)
 	end)
 end
 s.listed_card_types={TYPE_GEMINI}
@@ -25,6 +31,15 @@ function s.gmreg(c)
 		c:RegisterFlagEffect(id,RESET_PHASE|PHASE_DAMAGE,0,1)
 	end
 end
+function s.premark(c)
+	if c and c:IsGeminiStatus() then
+		c:RegisterFlagEffect(id,RESET_PHASE|PHASE_DAMAGE,0,1)
+	end
+end
+function s.precheck(e,tp,eg,ep,ev,re,r,rp)
+	s.premark(Duel.GetAttacker())
+	s.premark(Duel.GetAttackTarget())
+end
 function s.checkop(e,tp,eg,ep,ev,re,r,rp)
 	s.gmreg(Duel.GetAttacker())
 	s.gmreg(Duel.GetAttackTarget())
