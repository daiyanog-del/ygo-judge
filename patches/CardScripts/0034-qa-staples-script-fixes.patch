+--JudgemanAI 2026-11-27: "while this card battles, your opponent cannot activate ..." ends when the attack is negated.
+--Konami FAQ 23595 (Speedroid Tri-Eyed Dice vs Number S39: Utopia the Lightning).
+function Auxiliary.AttackNotNegatedCondition(con)
+	return function(e,...)
+		local a=Duel.GetAttacker()
+		return not (a and a:IsStatus(STATUS_ATTACK_CANCELED)) and con(e,...)
+	end
+end
