 function s.extrafilter(c,tp)
 	return c:IsLocation(LOCATION_MZONE) and c:IsControler(tp)
 end
+--A hand card that is also used through its own "can be used as material from the hand" effect
+--(e.g. "Micro Coder") does not count toward this card's limit of 1 (JudgemanAI 2026-11-23, Konami FAQ 23161)
+function s.othercover(tc,tp,sg,mg,lc)
+	for _,te in ipairs({Duel.GetPlayerEffect(tp,EFFECT_EXTRA_MATERIAL)}) do
+		local oc=te:GetOwner()
+		if te:GetHandler()==tc and not oc:IsOriginalCode(id) and te:CheckCountLimit(tp)
+			and tc:HasFlagEffect(oc:GetOriginalCode()) then
+			local op=te:GetOperation()
+			if not op or op(tc,te,tp,sg,mg,lc,Group.FromCards(tc),0) then return true end
+		end
+	end
+	return false
+end
+function s.ownmat(tc,tp,sg,mg,lc)
+	return tc:HasFlagEffect(id) and not s.othercover(tc,tp,sg,mg,lc)
+end
 function s.extracon(c,e,tp,sg,mg,lc,og,chk)
-	local ct=sg:FilterCount(Card.HasFlagEffect,nil,id)
+	local ct=sg:FilterCount(s.ownmat,nil,tp,sg,mg,lc)
 	return ct==0 or ((sg+mg):Filter(s.extrafilter,nil,e:GetHandlerPlayer()):IsExists(Card.IsCode,1,og,id) and ct<2)
 end
