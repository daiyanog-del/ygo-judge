@@ -3272,6 +3272,21 @@ int32_t field::check_trigger_effect(const chain& ch) const {
 		return TRUE;
 	return FALSE;
 }
+// JudgemanAI: while a chain resolves, a field trigger effect is queued once however many times its condition is met
+// (Q&A 23436, 18253, 18435, 22741, 12800). An entry whose condition failed (hand triggers) gives way to one that passes.
+bool field::queue_solving_trigger(chain_list& list, effect* peffect, bool act) {
+	if(!core.chain_solving || !(peffect->type & EFFECT_TYPE_FIELD))
+		return true;
+	auto it = std::find_if(list.begin(), list.end(), [peffect](const chain& ch) {
+		return ch.triggering_effect == peffect && (ch.flag & CHAIN_SOLVING_TRIGGER);
+	});
+	if(it == list.end())
+		return true;
+	if((it->flag & CHAIN_SOLVING_ACT) || !act)
+		return false;
+	list.erase(it);
+	return true;
+}
