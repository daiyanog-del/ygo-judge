+// Is there an EFFECT_TO_GRAVE_REDIRECT that is negated only by this card's own
+// continuous effects, and so starts applying the moment this card leaves?
+// (e.g. Macro Cosmos negated by Jinzo, Shenshen negated by Skill Drain)
+// JudgemanAI 2026-11-23, Konami FAQ 6878 and 23801: such a card cannot be sent to the GY as a cost.
+bool card::leave_reenables_grave_redirect() {
+	if(!(current.location & LOCATION_ONFIELD))
+		return false;
+	auto rg = pduel->game_field->effects.aura_effect.equal_range(EFFECT_TO_GRAVE_REDIRECT);
+	for(auto eit = rg.first; eit != rg.second; ++eit) {
+		effect* peff = eit->second;
+		card* phandler = peff->get_handler();
+		if(phandler == this || peff->is_flag(EFFECT_FLAG_CANNOT_DISABLE))
+			continue;
+		if(!phandler->get_status(STATUS_DISABLED) || peff->is_available())
+			continue;
+		effect_set dis;
+		phandler->filter_effect(EFFECT_DISABLE, &dis, FALSE);
+		if(dis.empty())
+			continue;
+		bool only_by_this = true;
+		for(const auto& d : dis) {
+			if(d->get_handler() != this || !(d->type & (EFFECT_TYPE_FIELD | EFFECT_TYPE_EQUIP | EFFECT_TYPE_TARGET))) {
+				only_by_this = false;
+				break;
+			}
+		}
+		if(!only_by_this)
+			continue;
+		phandler->set_status(STATUS_DISABLED, FALSE);
+		bool applies = peff->is_available() && peff->is_target(this)
+			&& (peff->is_flag(EFFECT_FLAG_IGNORE_IMMUNE) || is_affect_by_effect(peff));
+		uint32_t redirect = 0;
+		if(applies) {
+			pduel->lua->add_param<LuaParam::INT>(REASON_COST);
+			redirect = peff->get_value(this, 1);
+		}
+		phandler->set_status(STATUS_DISABLED, TRUE);
+		if(!applies)
+			continue;
+		uint8_t p = peff->get_handler_player();
+		if((redirect & LOCATION_HAND) && is_capable_send_to_hand(p, REASON_EFFECT, peff))
+			return true;
+		if((redirect & LOCATION_DECK) && is_capable_send_to_deck(p, REASON_EFFECT, peff))
+			return true;
+		if((redirect & LOCATION_REMOVED) && is_removeable(p, POS_FACEUP, REASON_EFFECT, peff))
+			return true;
+	}
+	return false;
+}
