diff --git a/field.cpp b/field.cpp
index 3594202..9b65f3d 100644
--- a/field.cpp
+++ b/field.cpp
@@ -3274,11 +3274,20 @@ int32_t field::check_trigger_effect(const chain& ch) const {
 }
 // JudgemanAI: while a chain resolves, a field trigger effect is queued once however many times its condition is met
 // (Q&A 23436, 18253, 18435, 22741, 12800). An entry whose condition failed (hand triggers) gives way to one that passes.
-bool field::queue_solving_trigger(chain_list& list, effect* peffect, bool act) {
+uint8_t field::solving_link_now() const {
+	if(core.chain_leave_sending)
+		return 0xff;
+	return core.chain_solving ? static_cast<uint8_t>(core.current_chain.size()) : 0;
+}
+bool field::queue_solving_trigger(chain_list& list, effect* peffect, bool act, const tevent& ev) {
 	if(!(core.chain_solving || core.chain_leave_sending) || !(peffect->type & EFFECT_TYPE_FIELD))
 		return true;
-	auto it = std::find_if(list.begin(), list.end(), [peffect](const chain& ch) {
-		return ch.triggering_effect == peffect && (ch.flag & CHAIN_SOLVING_TRIGGER);
+	//FAQ 15544: summons during the chain are one event (23436 ...); other events merge only within the same chain link (12929)
+	const bool summon = ev.event_code == EVENT_SUMMON_SUCCESS || ev.event_code == EVENT_SPSUMMON_SUCCESS || ev.event_code == EVENT_FLIP_SUMMON_SUCCESS;
+	const uint8_t link = solving_link_now();
+	auto it = std::find_if(list.begin(), list.end(), [peffect, summon, link](const chain& ch) {
+		return ch.triggering_effect == peffect && (ch.flag & CHAIN_SOLVING_TRIGGER)
+			&& (summon || ch.solving_link == link || ch.solving_link == 0xff || link == 0xff);
 	});
 	if(it == list.end())
 		return true;
