diff --git a/field.cpp b/field.cpp
index 9b65f3d..a44a120 100644
--- a/field.cpp
+++ b/field.cpp
@@ -3285,14 +3285,25 @@ bool field::queue_solving_trigger(chain_list& list, effect* peffect, bool act, c
 	//FAQ 15544: summons during the chain are one event (23436 ...); other events merge only within the same chain link (12929)
 	const bool summon = ev.event_code == EVENT_SUMMON_SUCCESS || ev.event_code == EVENT_SPSUMMON_SUCCESS || ev.event_code == EVENT_FLIP_SUMMON_SUCCESS;
 	const uint8_t link = solving_link_now();
-	auto it = std::find_if(list.begin(), list.end(), [peffect, summon, link](const chain& ch) {
+	// JudgemanAI [exception]: an effect with EFFECT_FLAG2_MERGE_CHAIN_SOLVING is queued once for the whole chain resolution
+	// and gets the event cards of every link (Konami FAQ 17974, 16090). Not a general rule: FAQ 11846 triggers once per link.
+	const bool merge_all = peffect->is_flag(EFFECT_FLAG2_MERGE_CHAIN_SOLVING);
+	auto it = std::find_if(list.begin(), list.end(), [peffect, summon, merge_all, link](const chain& ch) {
 		return ch.triggering_effect == peffect && (ch.flag & CHAIN_SOLVING_TRIGGER)
-			&& (summon || ch.solving_link == link || ch.solving_link == 0xff || link == 0xff);
+			&& (summon || merge_all || ch.solving_link == link || ch.solving_link == 0xff || link == 0xff);
 	});
 	if(it == list.end())
 		return true;
-	if((it->flag & CHAIN_SOLVING_ACT) || !act)
+	if((it->flag & CHAIN_SOLVING_ACT) || !act) {
+		if(merge_all && act && ev.event_cards && it->evt.event_cards) {
+			card_set merged = it->evt.event_cards->container;
+			merged.insert(ev.event_cards->container.begin(), ev.event_cards->container.end());
+			auto pgroup = pduel->new_group(std::move(merged));
+			pgroup->is_readonly = true;
+			it->evt.event_cards = pgroup;
+		}
 		return false;
+	}
 	list.erase(it);
 	return true;
 }
