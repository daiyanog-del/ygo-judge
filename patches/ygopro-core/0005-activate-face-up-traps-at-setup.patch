+// JudgemanAI: a Trap set up face-up is activated when the duel starts, so the effects its activation applies
+// exist (scenario.py). That activation stands for one made on an earlier turn: forget what it left in this turn's
+// records (once-per-turn counts, activity counters, effects that last until the End Phase).
+LUA_STATIC_FUNCTION(ResetTurnRecords) {
+	auto& field = pduel->game_field;
+	auto& core = field->core;
+	core.effect_count_code.clear();
+	for(auto& peffect : field->effects.rechargeable)
+		if(!peffect->is_flag(EFFECT_FLAG_NO_TURN_RESET))
+			peffect->recharge();
+	for(auto* counter : { &core.summon_counter, &core.normalsummon_counter, &core.spsummon_counter,
+	                      &core.flipsummon_counter, &core.attack_counter, &core.chain_counter })
+		for(auto& iter : *counter)
+			iter.second.player_amount[0] = iter.second.player_amount[1] = 0;
+	field->reset_phase(PHASE_END);
+	return 0;
+}
